  "story_name": "沙海残碑",
  "story_overview": "一部黄沙落日下的考古探险短剧，刻意制造记忆硬样本：一块楔形文字泥碑随剧情由完好→碎裂→拼合残片（状态变化）；一张后被证伪的伪造羊皮地图在揭穿后必须规避（废弃证据）；向导哈桑在沙暴中失散、多镜缺席后于绿洲回归（长时缺席）；两名同披沙色斗篷的身影（向导哈桑与劫匪）面容体态相近，易错认。",
  "creative_intent": {
    "genre": "沙漠考古探险 / 历史悬疑",
    "theme": "真相在碎片中拼合",
    "tone": "苍凉、炽热、悬疑",
    "target_duration_sec": 140.0,
    "visual_style": "黄沙、落日金光、扬尘、斗篷剪影、古物特写"
  },
  "main_entities": [
    {"entity_id": "E1", "name": "艾拉", "entity_type": "character", "appearance": "三十岁出头的女考古学家，戴宽檐帆布帽与护目镜，穿卡其探险装，脖挂放大镜，手上常沾沙尘。"},
    {"entity_id": "E2", "name": "楔形泥碑", "entity_type": "object", "appearance": "一块砖红色泥板，正面刻满楔形文字，边缘有古老磕痕，约两掌大。"},
    {"entity_id": "E3", "name": "伪造羊皮地图", "entity_type": "object", "appearance": "一张做旧的浅黄羊皮地图，墨线标注绿洲与遗址，右下角有一枚可疑的红蜡伪印。"},
    {"entity_id": "E4", "name": "向导哈桑", "entity_type": "character", "appearance": "沉稳的沙漠向导，披沙色粗布斗篷，缠深蓝头巾，左颊有风沙刻出的皱纹，牵一峰骆驼。"},
    {"entity_id": "E5", "name": "蒙面劫匪", "entity_type": "character", "appearance": "同披沙色斗篷的蒙面人，体态与哈桑相近，但缠赭红头巾、腰间别弯刀，眼神凶悍。"},
    {"entity_id": "E6", "name": "遗址石门", "entity_type": "location", "appearance": "半埋于沙丘的古遗址石门，门楣刻浮雕，两侧断柱，落日把阴影拉长。"},
    {"entity_id": "E7", "name": "沙暴荒漠", "entity_type": "location", "appearance": "无垠的赭黄沙丘，风起时黄沙蔽日、能见度极低。"},
    {"entity_id": "E8", "name": "绿洲营地", "entity_type": "location", "appearance": "棕榈环绕的小绿洲，几顶米色帐篷、一汪浅水、拴着骆驼。"}
